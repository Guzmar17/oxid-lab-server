# Copy to .env (your machine) or /etc/ecb-lab.env and /etc/ecb-backup.env (Azure). Never commit one.

# lab.setup and lab.staff only: the superuser, from the machine Postgres runs on (or compose).
ECB_ADMIN_URL=postgresql://postgres:password@localhost:5432/postgres
ECB_APP_PASSWORD=change-me
ECB_BACKUP_PASSWORD=change-me-too

# The server (/etc/ecb-lab.env): Postgres and RustFS by their Wireguard addresses.
ECB_DATABASE_URL=postgresql://ecb_app:change-me@10.2.X.Y:5432/ecb
ECB_S3_ENDPOINT=http://10.2.X.Z
ECB_S3_ACCESS_KEY=ecb-app
ECB_S3_SECRET_KEY=change-me
ECB_REPORTS_BUCKET=ecb-reports

# The backup (/etc/ecb-backup.env): its own role and its own RustFS user.
ECB_BACKUP_URL=postgresql://ecb_backup:change-me-too@10.2.X.Y:5432/ecb
ECB_BACKUP_S3_ENDPOINT=http://10.2.X.Z
ECB_BACKUP_S3_ACCESS_KEY=ecb-backup
ECB_BACKUP_S3_SECRET_KEY=change-me-too
ECB_BACKUP_BUCKET=ecb-backup
